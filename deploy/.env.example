# Image aus der GitHub Container Registry
RADSPUR_IMAGE=ghcr.io/maggo787878/radspur-server:latest

# Admin-Konto – wird NUR beim ersten Start angelegt. Danach Passwort in der
# Weboberfläche ändern (Konto); diese Werte werden dann nicht mehr verwendet.
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern

# Öffentliche Adresse der Seite – Basis für Einladungslinks
PUBLIC_URL=https://radspur.example.at

# Optional: gemeinsames Geräte-Token aus Versionen vor der Benutzerverwaltung.
# Gehört dem Admin. Leer lassen, sobald sich alle Handys mit Benutzername/Passwort angemeldet haben.
DEVICE_TOKEN=

# Routenplanung: Kartenkacheln für BRouter (je 5x5 Grad, ~150–250 MB).
# Standard Österreich + Grenzgebiete. Liste: https://brouter.de/brouter/segments4/
# Beispiel Deutschland zusätzlich: E5_N45 E10_N45 E15_N45 E5_N50 E10_N50
BROUTER_SEGMENTS=E5_N45 E10_N45 E15_N45
BROUTER_MEMORY=1g
# Kartendaten beim Start neu laden, wenn älter als so viele Tage (siehe docs/karten.md)
BROUTER_REFRESH_DAYS=30

# Wie lange Handy-Positionen aufbewahrt werden (Touren bleiben immer)
LOCATION_RETENTION_DAYS=30

# Veröffentlichter Port: 127.0.0.1 = nur nginx auf demselben Host,
# 0.0.0.0 = auch aus dem Netzwerk erreichbar
RADSPUR_BIND=127.0.0.1
RADSPUR_PORT=8080

# Nur bei Nginx Proxy Manager o. ä. im Container (docker-compose.npm.yml)
PROXY_NETWORK=npm_default

# Secure-Flag am Login-Cookie: auto = nur wenn nginx "X-Forwarded-Proto: https"
# meldet, false = nie (reines HTTP), true = immer
SECURE_COOKIE=auto
