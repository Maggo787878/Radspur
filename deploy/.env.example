# Image aus der GitHub Container Registry (Besitzer in Kleinbuchstaben)
RADSPUR_IMAGE=ghcr.io/CHANGE-ME/radspur-server:latest

# Passwort für die Weboberfläche
ADMIN_PASSWORD=bitte-aendern
# Token, das in der App eingetragen wird. Erzeugen mit: openssl rand -hex 32
DEVICE_TOKEN=bitte-aendern-mindestens-16-zeichen

# Wie lange Handy-Positionen aufbewahrt werden (Touren bleiben immer)
LOCATION_RETENTION_DAYS=30

# Nur für das Caddy-Profil: öffentlicher DNS-Name des Servers
DOMAIN=radspur.example.at

# Nur auf "false" setzen, wenn der Server ohne HTTPS getestet wird
SECURE_COOKIE=true
